// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs

Project metaspesa {
  Note: 'Database schema for Metaspesa shopping application'
  database_type: 'PostgreSQL'
}

// ─────────────────────────────────────────
// IDENTITY SCHEMA
// ─────────────────────────────────────────

Table identity.roles {
  note: 'User roles for access control'

  id integer [pk, increment]
  name varchar(100) [not null, unique]
  description varchar(255) [not null]

  indexes {
    name [name: 'idx_role_name']
  }
}

Table identity.users {
  note: 'Registered users of the shopping application'

  uid guid [pk]
  username varchar(255) [not null, unique]
  encrypted_password varchar(255) [not null]
  role_id integer [not null]

  indexes {
    username [name: 'idx_user_username']
    role_id [name: 'idx_user_role_id']
  }
}

Ref: identity.users.role_id > identity.roles.id [
  delete: restrict
]

// ─────────────────────────────────────────
// SHOPPING SCHEMA
// ─────────────────────────────────────────

Table shopping.shopping_lists {
  note: 'Shopping lists created by users, can be shared among multiple users'

  id integer [pk, increment]
  name varchar [note: 'Missing name indicates a temporary shopping list, not saved by the user']
  deleted_at timestamp

  checks {
    `name IS NOT NULL OR deleted_at IS NULL` [name: 'chk_shopping_list_temporary_cannot_be_soft_deleted']
  }
}

Table shopping.shopping_list_ownerships {
  note: 'Associates users with shopping lists, allowing for shared lists'

  user_uid guid [not null]
  shopping_list_id integer [not null]

  indexes {
    user_uid [name: 'idx_shopping_list_ownership_user_uid']
    shopping_list_id [name: 'idx_shopping_list_ownership_shopping_list_id']
    (user_uid, shopping_list_id) [pk, name: 'pk_shopping_list_ownership']
  }
}

Ref: shopping.shopping_list_ownerships.user_uid > identity.users.uid [
  delete: cascade
]
Ref: shopping.shopping_list_ownerships.shopping_list_id > shopping.shopping_lists.id [
  delete: cascade
]

Table shopping.shopping_items {
  note: '''
  Items that belong to a shopping list, representing planned purchases.
  Each line points to an existing market product and the exact product history
  row used when the item was added, so price and format are explicit.
  '''

  id integer [pk, increment]
  shopping_list_id integer [not null]
  product_id integer [not null]
  product_format_id integer [not null]
  amount integer [not null, default: 1, note: 'How many units/packages of the product are planned']
  is_checked boolean [not null, default: false]
  deleted_at timestamp

  indexes {
    shopping_list_id [name: 'idx_shopping_item_shopping_list_id']
    product_id [name: 'idx_shopping_item_product_id']
    product_format_id [name: 'idx_shopping_item_product_format_id']
    (shopping_list_id, product_format_id) [
      unique,
      name: 'idx_shopping_item_list_product_format'
    ]
  }

  checks {
    `amount > 0` [name: 'chk_shopping_item_positive_amount']
  }
}

Ref: shopping.shopping_lists.id < shopping.shopping_items.shopping_list_id [
  delete: cascade
]
Ref: shopping.shopping_items.product_id > market.products.id [
  delete: restrict
]
Ref: shopping.shopping_items.product_format_id > market.product_formats.id [
  delete: restrict
]
Ref: shopping.shopping_items.product_id > market.products_history.product_id [
  delete: restrict
]

Table shopping.purchases {
  note: '''
  Purchase receipt header. It records who bought, when, and optionally which
  shopping list was checked out. Product lines live in purchase_items.
  '''

  id integer [pk, increment]
  user_uid guid [not null]
  shopping_list_id integer
  purchased_at timestamp [not null, default: `now()`]

  indexes {
    user_uid [name: 'idx_purchases_user_uid']
    shopping_list_id [name: 'idx_purchases_shopping_list_id']
    purchased_at [name: 'idx_purchases_purchased_at']
  }
}

Ref: shopping.purchases.user_uid > identity.users.uid [
  delete: cascade
]
Ref: shopping.purchases.shopping_list_id > shopping.shopping_lists.id [
  delete: set null
]

Table shopping.purchase_items {
  note: '''
  Immutable purchase receipt lines. Each line references the exact market
  product history row used for analytics, which provides the exact price and
  format paid at purchase time.
  '''

  id integer [pk, increment]
  purchase_id integer [not null]
  product_id integer [not null]
  product_history_id integer [not null]
  amount integer [not null, default: 1, note: 'How many units/packages were bought']

  indexes {
    purchase_id [name: 'idx_purchase_item_purchase_id']
    product_id [name: 'idx_purchase_item_product_id']
    product_history_id [name: 'idx_purchase_item_product_history_id']
  }

  checks {
    `amount > 0` [name: 'chk_purchase_item_positive_amount']
  }
}

Ref: shopping.purchase_items.purchase_id > shopping.purchases.id [
  delete: cascade
]
Ref: shopping.purchase_items.product_id > market.products.id [
  delete: restrict
]
Ref: shopping.purchase_items.product_history_id > market.products_history.id [
  delete: restrict
]
Ref: shopping.purchase_items.product_id > market.products_history.product_id [
  delete: restrict
]


// ─────────────────────────────────────────
// MARKET SCHEMA
// ─────────────────────────────────────────

Table market.super_markets {
  note: 'Supermarkets where products are available'

  id integer [pk, increment]
  name varchar [not null, unique]
  logo_url varchar

  indexes {
    name [name: 'idx_super_market_name']
  }
}

Table market.product_brands {
  note: 'Brands of products available in the market'

  id integer [pk, increment]
  name varchar [not null, unique]

  indexes {
    name [name: 'idx_product_brand_name']
  }
}

Table market.units_of_measure {
  note: '''
  Units used to describe product package format, not shopping count.
  Examples: ml, l, g, kg, piece.
  '''

  id integer [pk, increment]
  code varchar(16) [not null, unique, note: 'Stable unit code, e.g. ml, kg, piece']
  name varchar(64) [not null]

  indexes {
    code [name: 'idx_unit_of_measure_code']
  }
}

Table market.products {
  note: 'Products available in the market'

  id integer [pk, increment]
  name varchar [not null]
  super_market_id integer [not null]
  brand_id integer [not null]

  indexes {
    super_market_id [name: 'idx_product_super_market_id']
    brand_id [name: 'idx_product_brand_id']
    (name, super_market_id, brand_id) [
      unique,
      name: 'idx_product_name_super_market_brand'
    ]
  }
}

Ref: market.products.super_market_id > market.super_markets.id [
  delete: cascade
]
Ref: market.products.brand_id > market.product_brands.id [
  delete: cascade
]

Table market.product_formats {
  note: '''
  Different package formats for the same product. For example, a soda can be sold
  in 330 ml cans, 500 ml bottles, or 1 l bottles. Each format has its own price
  history in products_history.
  '''

  id integer [pk, increment]
  product_id integer [not null]
  quantity decimal(10, 3) [not null]
  unit_of_measure_id integer [not null]
  image_url varchar [not null]

  indexes {
    product_id [name: 'idx_product_format_product_id']
    unit_of_measure_id [name: 'idx_product_format_unit_of_measure_id']
    (product_id, quantity, unit_of_measure_id) [unique, name: 'idx_product_format_identity']
  }

  checks {
    `quantity > 0.000` [name: 'chk_product_format_positive_quantity']
  }
}
Ref: market.product_formats.product_id > market.products.id [
  delete: cascade
]
Ref: market.product_formats.unit_of_measure_id > market.units_of_measure.id [
  delete: cascade
]

Table market.products_history {
  note: '''
  Historical price and format data for products, tracking changes over time.
  '''

  id integer [pk, increment]
  product_id integer [not null]
  product_format_id integer [not null]
  price decimal(10, 2) [not null]
  created_at timestamp [not null, default: `now()`]

  checks {
    `price > 0.00` [name: 'chk_positive_price']
  }

  indexes {
    product_id [name: 'idx_product_history_product_id']
    product_format_id [name: 'idx_product_history_product_format_id']
    created_at [name: 'idx_product_history_created_at']
    (id, product_id) [
      unique,
      name: 'idx_product_history_id_product_id'
    ]
  }
}

Ref: market.products_history.product_id > market.products.id [
  delete: cascade
]
Ref: market.products_history.product_format_id > market.product_formats.id [
  delete: cascade
]