@startuml metaspesa_domain

title Metaspesa real-world domain


package Market {
  class PriceSnapshot {
    + price
    + observedDate
  }

  class Brand {
    + name
  }

  class ProductFormat {
    + quantity
    + unit
    + image
  }
  ProductFormat *--> "*" PriceSnapshot : price history

  class Product {
    + name
  }
  Product "*" --> Brand : branded as
  Product *--> "*" ProductFormat : offered in

  class Category {
    + name
  }
  Category o--> "*" Product : groups

  class Supermarket {
    + name
    + logo
  }
  Supermarket o--> "*" Product : sells
}

package Planning {
  class ShoppingItem {
    + amount
    + isChecked
  }
  ShoppingItem "*" --> ProductFormat : plans package
  ShoppingItem "*" --> PriceSnapshot : chosen price

  class ShoppingList {
    + name
    + isTemporary()
  }
  ShoppingList *--> "*" ShoppingItem : contains
}

package Purchase {
  class PurchasedItem {
    + amount
  }
  PurchasedItem "*" --> ProductFormat : bought package
  PurchasedItem "*" --> PriceSnapshot : paid price

  class Purchase {
    + bought at
  }
  Purchase "?" --> ShoppingList : completes
  Purchase *--> "*" PurchasedItem : contains
}

package Identity {
  class Role {
    + name
    + description
  }

  class Shopper {
    + username
  }
  Shopper --> "*" Purchase : makes
  Shopper --> Role : has
  Shopper "+" --> "+" ShoppingList : owns or shares
}

@enduml