# Required: replace with a strong local password before starting Grafana.
GRAFANA_PASSWORD=<strong-production-password>

# Preserve current deployment identity/data during the incremental extraction.
# For a new independent installation, choose distinct project/network/volume names.
OBSERVABILITY_PROJECT_NAME=metaspesa
OBSERVABILITY_NETWORK=metaspesa_telemetry
LOKI_VOLUME_NAME=metaspesa_loki_data
MIMIR_VOLUME_NAME=metaspesa_mimir_data
TEMPO_VOLUME_NAME=metaspesa_tempo_data
GRAFANA_VOLUME_NAME=metaspesa_grafana_data
