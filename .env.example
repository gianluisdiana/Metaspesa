POSTGRES_DB=metaspesa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong-production-password>
GRAFANA_DB_PASSWORD=<strong-production-password>
METASPESA_VERSION=1.0.0
METASPESA_PROJECT_NAME=metaspesa

# Optional telemetry adapter; unused by plain docker compose up.
OBSERVABILITY_NETWORK=observability_telemetry
OBSERVABILITY_SECRETS_DIR=./observability/secrets
# Asset path resolves against the observability Compose directory, not this file.
METASPESA_TELEMETRY_DIR=../telemetry
