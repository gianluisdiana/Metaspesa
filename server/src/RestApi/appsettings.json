{
  "AllowedHosts": "*",
  "BrowserSecurity": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Jwt": {
    "KeySecretName": "jwt_secret_key",
    "Issuer": "metaspesa",
    "Audience": "metaspesa-clients",
    "ExpirationMinutes": 60
  },
  "BrowserSession": {
    "CookieName": "metaspesa_session"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
